# For a server that already runs nginx with a certificate covering these names
# (for example a wildcard certificate). Adjust server_name and the certificate paths, then reload nginx.
# The stack listens on 127.0.0.1 only; the containers reach these same names through this proxy.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 443 ssl;
    server_name nt-node.example.org;
    ssl_certificate     /etc/ssl/example.org/fullchain.pem;
    ssl_certificate_key /etc/ssl/example.org/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:4570;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 4m;   # sign-in presentations can carry a certificate
    }
}

server {
    listen 443 ssl;
    server_name nt-rp.example.org;
    ssl_certificate     /etc/ssl/example.org/fullchain.pem;
    ssl_certificate_key /etc/ssl/example.org/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:4571;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl;
    server_name nt-wallet.example.org;
    ssl_certificate     /etc/ssl/example.org/fullchain.pem;
    ssl_certificate_key /etc/ssl/example.org/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:4572;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 4m;
    }
}

server {
    listen 443 ssl;
    server_name nt-grafana.example.org;
    ssl_certificate     /etc/ssl/example.org/fullchain.pem;
    ssl_certificate_key /etc/ssl/example.org/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:4574;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
